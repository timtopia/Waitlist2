generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

// NextAuth required models
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id                     String         @id @default(cuid())
  name                   String?
  email                  String?        @unique
  emailVerified          DateTime?
  image                  String?
  stripeConnectId        String?
  stripeConnectOnboarded Boolean        @default(false)
  emailNotifications     Boolean        @default(true)
  // A guest the host added at the stand: no account, no email, can't sign in
  isWalkIn               Boolean        @default(false)
  accounts               Account[]
  sessions               Session[]
  createdLines           Line[]         @relation("LineCreator")
  positions              LinePosition[]
  queueVisits            QueueVisit[]
  lineReminders          LineReminder[]
  createdAt              DateTime       @default(now())
}

model VerificationToken {
  id         String   @id @default(cuid())
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Waitlyst app models
model Line {
  id                    String         @id @default(cuid())
  name                  String
  description           String?
  createdById           String
  createdBy             User           @relation("LineCreator", fields: [createdById], references: [id])
  positions             LinePosition[]
  visits                QueueVisit[]
  reminders             LineReminder[]
  isActive              Boolean        @default(true)
  pausedAt              DateTime? // When the line was last paused; called people's clocks stop until it resumes
  isPublic              Boolean        @default(true)
  opensAt               DateTime? // When the line opens for joining (null = open immediately)
  closesAt              DateTime? // When the line stops accepting new joins (null = never closes)
  maxCapacity           Int? // Maximum number of positions allowed (null = unlimited)
  ownerFeePercent       Float          @default(0) // Percentage the line owner earns on each sale (e.g. 10 = 10%)
  announcement          String? // Owner announcement shown as banner (max ~280 chars)
  announcementAt        DateTime? // When the announcement was last set
  productName           String? // Product name (e.g. "Nike Dunk Low Travis Scott")
  productImage          String? // URL to product image
  productPrice          Float? // Retail / MSRP price in dollars
  productUrl            String? // Link to official product page
  allowResale           Boolean        @default(true) // Whether position trading is enabled
  maxAskingPrice        Float? // Maximum resale price cap (null = no limit)
  nowServing            String? // Name of the person currently being served (display only)
  nowServingUserId      String? // Who was called -- compare this, not the name
  nowServingAt          DateTime? // When the current person was called
  hideCapacity          Boolean        @default(false) // When true, don't show exact capacity to non-owners
  purchaseLimit         Int? // "1 per person" on a drop: shown to customers and staff; null = no limit
  responseWindowMinutes Int? // A called person who does not show within this many minutes is skipped as a no-show
  // RESTAURANT lines take party sizes (capacity counts guests) and hold swap
  // payments until the guest is served; STANDARD lines collect and pay out
  // the moment a swap completes.
  kind                  LineKind       @default(STANDARD)
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt

  @@index([createdById])
}

model LinePosition {
  id            String        @id @default(cuid())
  lineId        String
  line          Line          @relation(fields: [lineId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  position      Int // 1 = first in line
  partySize     Int           @default(1) // Guests in this party; always 1 on STANDARD lines
  askingPrice   Float? // null = not for sale
  lockedUntil   DateTime? // Position is locked for swap until this time
  lockedBy      String? // Transaction ID that locked this position
  fulfilled     Boolean       @default(false) // Creator marks this when the person has purchased/received the item
  calledAt      DateTime? // When the organizer last called them up
  note          String? // e.g. "high chair", "patio" -- seen by the guest and the owner only
  quotedMinutes Int? // The host's own wait estimate for this party
  quotedAt      DateTime? // When the host gave it
  response      CallResponse? // What they said after being called; cleared on each new call
  respondedAt   DateTime?
  fulfilledAt   DateTime? // When they were fulfilled
  joinedAt      DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([lineId, userId]) // User can only be in a line once
  @@unique([lineId, position]) // Each position is unique per line
  @@index([lineId])
  @@index([userId])
}

model Transaction {
  id                    String            @id @default(cuid())
  buyerId               String
  sellerId              String
  lineId                String
  amount                Float // Seller's asking price (what seller receives)
  ownerFee              Float             @default(0) // Fee paid to line owner
  platformFee           Float             @default(0) // Fee paid to platform
  stripePaymentId       String? // Checkout session ID
  stripePaymentIntentId String? // Set once checkout completes; refund events arrive keyed by it
  status                TransactionStatus @default(PENDING)
  settledAt             DateTime? // Closed out: money collected and released, or returned to the buyer
  capturedAt            DateTime? // Buyer's payment actually collected
  sellerPaidAt          DateTime? // Seller's take sent to their payout account
  ownerPaidAt           DateTime? // Owner's fee sent to their payout account
  captureBefore         DateTime? // The card hold lapses after this unless the payment is collected
  holdExpiredAt         DateTime? // The hold lapsed before it was collected
  createdAt             DateTime          @default(now())

  @@index([lineId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([stripePaymentIntentId])
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

model SwapOffer {
  id            String      @id @default(cuid())
  lineId        String
  fromUserId    String // person behind (offering to swap)
  toUserId      String // person in front (receiving offer)
  amount        Float // offered price
  status        OfferStatus @default(PENDING)
  expiresAt     DateTime // PENDING offers stop being acceptable after this
  transactionId String? // The checkout started when it was accepted
  createdAt     DateTime    @default(now())

  @@unique([lineId, fromUserId, toUserId]) // 1 offer per pair
  @@index([lineId])
  @@index([toUserId])
}

enum OfferStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED // Timed out, or the queue moved so the two are no longer adjacent
  WITHDRAWN // The offerer took it back
}

// One row per time someone left a line, however they left. Positions are
// deleted on exit, so this is the only lasting record of who was served and
// how fast the line moved.
model QueueVisit {
  id        String       @id @default(cuid())
  lineId    String
  line      Line         @relation(fields: [lineId], references: [id], onDelete: Cascade)
  userId    String
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  outcome   VisitOutcome
  position  Int // Place in line when they left
  partySize Int          @default(1) // Guests in the party (for wait-by-party-size analytics)
  joinedAt  DateTime
  calledAt  DateTime?
  servedAt  DateTime?
  exitedAt  DateTime     @default(now())

  @@index([lineId, servedAt])
  @@index([userId])
}

enum CallResponse {
  ON_MY_WAY
  RUNNING_LATE
}

enum VisitOutcome {
  SERVED // Marked served before leaving the line
  LEFT // Left on their own
  REMOVED // Removed by the organizer without being served
  NO_SHOW // Called (or due) but never turned up; removed by the organizer
}

enum LineKind {
  STANDARD
  RESTAURANT
}

/// Someone asked to be emailed when a scheduled line opens
model LineReminder {
  id        String    @id @default(cuid())
  lineId    String
  line      Line      @relation(fields: [lineId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  sentAt    DateTime? // When the "it's open" email went out

  @@unique([lineId, userId])
  @@index([sentAt])
}
